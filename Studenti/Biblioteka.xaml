<Window x:Class="Studenti.Biblioteka"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Studenti"
        mc:Ignorable="d"
        Title="Biblioteka" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="dgBiblioteka"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          Margin="5" CellEditEnding="dgBiblioteka_CellEditEnding">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding ID}" Visibility="Hidden"/>

                <DataGridTextColumn Header="Ime"  Binding="{Binding Ime}" />
                <DataGridTextColumn Header="Prezime" Binding="{Binding Prezime}" />
                

                <DataGridCheckBoxColumn Header="Razduženo" Binding="{Binding Razduzeno, Mode=TwoWay}" IsReadOnly="False" />

            </DataGrid.Columns>

        </DataGrid>
        <Label Content="Ime:" Margin="20,350,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Name="txtIme" Width="120" Height="25" Margin="60,350,0,0"
         HorizontalAlignment="Left" VerticalAlignment="Top"/>

        <Label Content="Prezime:" Margin="200,350,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <TextBox Name="txtPrezime" Width="120" Height="25" Margin="270,350,0,0"
         HorizontalAlignment="Left" VerticalAlignment="Top"/>
        <Button 
                Name="btnIzlaz" Content="Izlaz" 
                Click="btnIzlaz_Click" Margin="700,341,18,46" Background="AliceBlue"/>
        <Button 
    Name="btnDodaj" Content="Dodaj"
    Click="btnDodaj_Click" Margin="536,341,182,46" Background="Beige"/>
        <Button x:Name="btnObrisi" Content="Obrisi" Click="btnObrisi_Click" Margin="615,341,97,46" Background="LightGray"/>
    </Grid>
</Window>
