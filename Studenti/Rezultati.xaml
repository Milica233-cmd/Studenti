<Window x:Class="Studenti.Rezultati"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Studenti"
        mc:Ignorable="d"
        Title="Rezultati" Height="600" Width="800" Background="Bisque" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>

            <RowDefinition Height="55"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition ></RowDefinition>
            <RowDefinition Height="55"></RowDefinition>
            <RowDefinition Height="100"></RowDefinition>
            <RowDefinition ></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>

        </Grid.ColumnDefinitions>
        <Label Background="Ivory" Grid.Column="0" Grid.Row="0" Height="44"  Name="lblNaziviStudenta" Margin="3" TextBlock.TextAlignment="Center"  HorizontalContentAlignment="Center" >
            <TextBlock TextWrapping="WrapWithOverflow" Padding="5,10,5,5" HorizontalAlignment="Center"  VerticalAlignment="Center">Ime i prezime
            </TextBlock>
        </Label>
        <ListBox Grid.Column="0" Grid.Row="1" Grid.RowSpan="5" Name="lstStudenta" Margin="8,0,2,10"
                                 SelectedValuePath="ID" SelectedIndex="-1" DisplayMemberPath="ImePrezime" SelectionChanged="lstStudenta_SelectionChanged" ></ListBox>
        <Label Background="Ivory" Grid.Column="1" Grid.Row="0" Height="44"  Name="lblPredmeti" Margin="3" TextBlock.TextAlignment="Center"  HorizontalContentAlignment="Center" >
            <TextBlock TextWrapping="WrapWithOverflow" Padding="5,10,5,5" HorizontalAlignment="Center"  VerticalAlignment="Center">Predmet
            </TextBlock>
        </Label>
        <ComboBox Grid.Column="1" Grid.Row="1" Height="60" Name="cboPredmet" Margin="3,3,3,32" IsReadOnly="true" Grid.ColumnSpan="1"   DisplayMemberPath="Naziv" SelectedValuePath="ID"
                      IsEditable="False"  VerticalContentAlignment="Center" SelectionChanged="cboPredmet_SelectionChanged"  ></ComboBox>
        <Button Name="btnDodaj" Content="Dodaj )))" Grid.Column="1" Grid.Row="3" Height="44" Width="100"  IsEnabled="False" Click="btnDodaj_Click" ></Button>
        <Button Grid.Column="1" Name="btnUkloni" Content="((( Ukloni" Grid.Row="4" Height="44" Width="100"  Click="btnUkloni_Click"></Button>
        <Label Background="Ivory" Grid.Column="2" Grid.Row="0" Height="44"  Name="lblPolozili" Margin="3" TextBlock.TextAlignment="Center"  HorizontalContentAlignment="Center" >
            <TextBlock TextWrapping="WrapWithOverflow" Padding="5,10,5,5" HorizontalAlignment="Center"  VerticalAlignment="Center">Polozili
                
            </TextBlock>
        </Label>
        <ListBox Grid.Column="2" Grid.Row="1" Grid.RowSpan="5" Name="lstPolozili" Margin="2,0,8,10"
                                 SelectedValuePath="ID" SelectedIndex="-1" DisplayMemberPath="Polozili" SelectionChanged="lstPolozili_SelectionChanged" ></ListBox>
        <Button Name="btnIzlaz" Content="Izlaz" Grid.Column="1" Grid.Row="5" Height="44" Width="100"  Click="btnIzlaz_Click" ></Button>
    </Grid>
</Window>
