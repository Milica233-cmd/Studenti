<Window x:Class="Studenti.Profesori"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Studenti"
        xmlns:wf="clr-namespace:Microsoft.Reporting.WinForms;assembly=Microsoft.ReportViewer.WinForms"
        xmlns:WindowsFormsIntegration="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="Profesori1" Height="450" Width="800" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" Background="BlanchedAlmond">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profesor -->
        <Label Grid.Row="0" Grid.Column="0"
           Background="Gray"
           Content="Profesor"
           HorizontalContentAlignment="Center"/>



        <!-- Ime -->
        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Content="Ime:"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4"
             Name="txtIme"
             Height="30"/>

        <!-- Prezime -->
        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="1" Content="Prezime:"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4"
             Name="txtPrezime"
             Height="30"/>

        <!-- Predmet -->
        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="1" Content="Predmet:"/>
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4"
             Name="txtPredmet"
             Height="30"/>

        <!-- Dugme -->
        <!--<Button Grid.Row="4" Grid.Column="1"
        Content="Dodaj"
        Width="100"
        Height="35"
        Click="Dodaj_Click"/>-->

        <Button Grid.Column="2" Grid.Row="4"
              Name="btnUnesi" 
              Content="Unesi"
              Click="btnUnesi_Click" Margin="30,12,30,12" Background="Beige"
                />

        <Button Grid.Column="3" Grid.Row="4"
                Name="btnIzmeni" Content="Izmeni"
                Margin="30,12,30,12" Click="btnIzmeni_Click" Background="LightPink"></Button>

        <Button Grid.Column="4" Grid.Row="4" 
                Name="btnObrisi" Content="Obriši" 
                Margin="30,12,30,12" Click="btnObrisi_Click" Background="LightGray" ></Button>

        <Button Grid.Column="1" Grid.Row="4" 
                Name="btnIzlaz" Content="Izlaz" 
                Click="btnIzlaz_Click" Margin="30,12,30,12" Background="AliceBlue"></Button>
        
        <Button Grid.Column="0" Grid.Row="4"
        Name="btnIzvestaj"
        Content="Izveštaj"
        Click="btnIzvestaj_Click"
        Margin="30,12,30,12"
        Background="LightGreen"/>

        <!-- Tabela -->
        <DataGrid Grid.Row="5"
              Grid.ColumnSpan="6"
              Margin="5"
              Name="dgProfesori" SelectionChanged="dgProfesori_SelectionChanged"
                  AutoGeneratedColumns="dgProfesori_AutoGeneratedColumns"
                  IsReadOnly="True" SelectionMode="Single" />

        <WindowsFormsIntegration:WindowsFormsHost Grid.Row="6" Grid.ColumnSpan="6">
            <wf:ReportViewer x:Name="reportViewer1"/>
        </WindowsFormsIntegration:WindowsFormsHost>
        <!--<Button Content="Button" HorizontalAlignment="Left" VerticalAlignment="Top" Width="75" Margin="45,20,0,0" Grid.Row="4"/>-->

    </Grid>
</Window>
