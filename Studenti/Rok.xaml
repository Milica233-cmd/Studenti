<Window x:Class="Studenti.Rok"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Studenti"
        mc:Ignorable="d"
        Title="Rok" Height="450" Width="800" Background="BlanchedAlmond" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="35"></RowDefinition>
            <RowDefinition Height="56"></RowDefinition>
            <RowDefinition></RowDefinition>


        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>
            <ColumnDefinition ></ColumnDefinition>


        </Grid.ColumnDefinitions>
        <Label Background="Ivory" Grid.Column="0" Grid.Row="0" Height="44"  Name="lblNazivIspita" Margin="0"  ></Label>
        <TextBlock TextWrapping="WrapWithOverflow"  HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="43,10,17,15" Width="98">Naziv ispita</TextBlock>
        <Label Background="Ivory" Grid.Column="0" Grid.Row="1" Height="44"  Name="lblDatum" Margin="0" TextBlock.TextAlignment="Center"  HorizontalContentAlignment="Center" ></Label>
        <TextBlock TextWrapping="WrapWithOverflow"  HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="56,10,56,16" Grid.Row="1">Datum</TextBlock>
        <Label Background="Ivory" Grid.Column="0" Grid.Row="2" Height="44"  Name="lblSkola" Margin="0,0,0,26" TextBlock.TextAlignment="Center"  HorizontalContentAlignment="Center" Grid.RowSpan="2" VerticalAlignment="Bottom" ></Label>
        <TextBlock TextWrapping="WrapWithOverflow" Padding="5,10,5,5" HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="61,0,40,0" Grid.Row="2" Height="35" RenderTransformOrigin="1.484,0.776" Width="57">Skola</TextBlock>
        <Label Background="Ivory" Grid.Column="0" Grid.Row="3" Height="44"  Name="lblPodatak" Margin="0" TextBlock.TextAlignment="Center"  HorizontalContentAlignment="Center" ></Label>
        <TextBlock TextWrapping="WrapWithOverflow" Padding="5,10,5,5" HorizontalAlignment="Center"  VerticalAlignment="Center" Margin="55,0,17,4" Grid.Row="3" Width="86" Height="31">Podatak</TextBlock>
        <DatePicker Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" Name="dtpDatum" Margin="5" Grid.ColumnSpan="2"/>
        <CheckBox Background="White" Grid.Row="3" Grid.Column="1"  Name="chkPodatak" Height="56" VerticalAlignment="Top" Checked="CheckBox_Checked" Margin="0,10,0,0" Grid.RowSpan="2">
            tacno/netacno
        </CheckBox>

        <Button Grid.Column="1" Grid.Row="4" Name="btnUnesi" Content="Unesi" Margin="30,12,30,12" Click="btnUnesi_Click" Background="Beige"></Button>
        <Button Grid.Column="2" Grid.Row="4" Name="btnIzmeni" Content="Izmeni" Margin="30,12,30,12" Click="btnIzmeni_Click" Background="LightPink"></Button>
        <Button Grid.Column="3" Grid.Row="4" Name="btnObrisi" Content="Obriši" Margin="30,12,30,12" Click="btnObrisi_Click" Background="LightGray"></Button>
        <Button Grid.Column="4" Grid.Row="4" Name="btnOdustani" Content="Odustani" Margin="30,12,30,12" Click="btnOdustani_Click" Background="Lavender"></Button>
        <Button Grid.Column="0" Grid.Row="4" Name="btnIzlaz" Content="Izlaz" Click="btnIzlaz_Click" Margin="30,12,30,12" Background="AliceBlue"></Button>

        <StackPanel   Grid.Column="1" Grid.Row="2" Name="stcSkola" Height="56"  >
            <GroupBox>
                <StackPanel>
                    <RadioButton Name="rbtnSrednja" IsChecked="True" >Srednja</RadioButton>
                    <RadioButton Name="rbtnOsnovna" >Osnovna</RadioButton>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <ComboBox Grid.Column="1" Grid.Row="0" Name="cboIspit" Margin="0"    DisplayMemberPath="Naziv" SelectedValuePath="ID"
                       VerticalContentAlignment="Center" SelectionChanged="cboIspit_SelectionChanged"  ></ComboBox>


        <DataGrid Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="5" Margin="5" Name="dgRok" 
              MinColumnWidth="350"  SelectedValuePath="ID" CanUserAddRows="False" 
                  SelectionChanged="dgRok_SelectionChanged" AutoGeneratedColumns="dgRok_AutoGeneratedColumns" IsReadOnly="True" SelectionMode="Single" ></DataGrid>
    </Grid>
</Window>
